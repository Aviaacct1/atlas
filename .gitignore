# Atlas: what never enters the repository.
# Data lives on the workstation and resolves through avia_forecast/paths.py; results
# are regenerated by the build. A results file swept into a commit travels to the
# workstation in the clone, where a watcher can find the stale copy already there and
# release early. That happened on Meridian on 8 August 2026.
# Author: Avia Solutions.

# --- interpreter and tooling -------------------------------------------------
__pycache__/
*.pyc
*.tmp
.DS_Store
.pytest_cache/
venv/
.venv/
_dt_cache/

# --- data stores: never, at any size ----------------------------------------
*.duckdb
*.duckdb.wal
*.tif
*.parquet

# --- logs and run output -----------------------------------------------------
*.log
*.err.log
ingest_manifest.json
# exception: the BT2 experiment log is the evidence record of what was tried and what
# it scored, not a run artefact. It travels with the bt2 scripts when they come in.
!scripts/bt2/bt2_experiments.log

# --- generated deliverables --------------------------------------------------
*.pptx
*.pdf
*.xlsx
!tests/fixtures/*.xlsx
!config/**/*.xlsx

# --- served data: every file here is written by the build --------------------
# Named one by one before 8 August 2026, which let capacity.json through. A served
# file that travels in a clone is the stale-result failure Meridian hit: provision by
# running the build, never by shipping last week's output.
webapp/data/*.json

# --- large generated extracts (regenerate via the build) ---------------------
data/airport_regress.json
data/peak_panel.json
data/capacity_layer_extract.json

# --- in-tree backup folders: regenerated output under another name -----------
backup_pre_*/
backup_*_[0-9]*/

# --- superseded model artefact; the promoted model (bt2_model_v1_2.pkl) IS tracked
data/bt2_model.pkl

# --- config backups written by the patch scripts -----------------------------
config/*.bak-*

# --- machine and host configuration ------------------------------------------
avia_config.json

# --- the shared access password (never commit the secret) --------------------
webapp/access_password.txt
